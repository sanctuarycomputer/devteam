{
  "contract": "project-hosts@1",
  "about": "Cases for project-hosts@1, defined in cloud/gateway.mjs's header comment. labelCases give a name, the projects and previews the hub lists (projects defaults to [name]), and what the name's host is: project (its dashboard), shared (no dashboard; its stored pages still answer), preview, unknown (listed nowhere), or refused with a reason. samples are addresses on box, each with what answers it.",
  "reservedLabels": ["term", "public", "www"],
  "reservedSegments": ["api", "artifact", "c", "healthz", "index.html", "public-manifest", "review", "upload", "view"],
  "labelCases": [
    { "name": "alpha", "expect": "project" },
    { "name": "beta-app", "expect": "project" },
    { "name": "a", "expect": "project" },
    { "name": "a1-2b", "expect": "project" },
    { "name": "abbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbc", "expect": "project" },
    { "name": "abbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbc", "expect": "refused", "reason": "not-a-label" },
    { "name": "4321", "expect": "refused", "reason": "all-digits" },
    { "name": "0", "expect": "refused", "reason": "all-digits" },
    { "name": "term", "expect": "refused", "reason": "reserved" },
    { "name": "public", "expect": "refused", "reason": "reserved" },
    { "name": "www", "expect": "refused", "reason": "reserved" },
    { "name": "DevTeam", "expect": "refused", "reason": "not-a-label" },
    { "name": "my_app", "expect": "refused", "reason": "not-a-label" },
    { "name": "my.app", "expect": "refused", "reason": "not-a-label" },
    { "name": "-app", "expect": "refused", "reason": "not-a-label" },
    { "name": "app-", "expect": "refused", "reason": "not-a-label" },
    { "name": "", "expect": "refused", "reason": "not-a-label" },
    { "name": "twin", "projects": ["twin", "twin"], "expect": "shared" },
    { "name": "twin", "projects": ["twin", "twin"], "previews": ["twin"], "expect": "shared" },
    { "name": "cool-tiger", "projects": ["cool-tiger"], "previews": ["cool-tiger"], "expect": "project" },
    { "name": "cool-tiger", "projects": [], "previews": ["cool-tiger"], "expect": "preview" },
    { "name": "nobody", "projects": [], "expect": "unknown" }
  ],
  "box": {
    "name": "box.localhost",
    "projects": ["alpha", "beta-app", "twin", "twin"],
    "previews": ["cool-tiger", "alpha", "twin"],
    "published": { "alpha": ["launch-notes", "view"], "twin": ["twin-notes"], "retired": ["old-notes"] }
  },
  "samples": [
    { "url": "https://box.localhost/", "expect": "box" },
    { "url": "https://box.localhost/auth/login?next=https%3A%2F%2Falpha.box.localhost%2F%23board", "expect": "box" },
    { "url": "https://box.localhost/dev/", "expect": "box" },
    { "url": "https://box.localhost/box.json", "expect": "box" },
    { "url": "https://box.localhost/public/publish?project=alpha&slug=launch-notes", "expect": "box" },
    { "url": "https://term.box.localhost/", "expect": "terminal" },
    { "url": "https://alpha.box.localhost/", "expect": "dashboard" },
    { "url": "https://alpha.box.localhost/#board?goal=g-1", "expect": "dashboard" },
    { "url": "https://alpha.box.localhost/api/data", "expect": "dashboard" },
    { "url": "https://alpha.box.localhost/view/artifact/launch-notes?at=main", "expect": "dashboard" },
    { "url": "https://alpha.box.localhost/view/", "expect": "dashboard" },
    { "url": "https://alpha.box.localhost/settings", "expect": "dashboard" },
    { "url": "https://beta-app.box.localhost/", "expect": "dashboard" },
    { "url": "https://alpha.box.localhost/launch-notes/", "expect": "public-page" },
    { "url": "https://alpha.box.localhost/launch-notes/css/site.css", "expect": "public-page" },
    { "url": "https://twin.box.localhost/twin-notes/", "expect": "public-page" },
    { "url": "https://retired.box.localhost/old-notes/", "expect": "public-page" },
    { "url": "https://twin.box.localhost/", "expect": "no-dashboard" },
    { "url": "https://twin.box.localhost/api/data", "expect": "no-dashboard" },
    { "url": "https://cool-tiger.box.localhost/", "expect": "preview" },
    { "url": "https://nobody.box.localhost/", "expect": "unknown" },
    { "url": "https://retired.box.localhost/", "expect": "unknown" },
    { "url": "https://4321.box.localhost/", "expect": "gone" },
    { "url": "https://public.box.localhost/alpha/launch-notes/", "expect": "gone" },
    { "url": "https://www.box.localhost/", "expect": "gone" },
    { "url": "https://a_b.box.localhost/", "expect": "gone" }
  ],
  "boxJson": {
    "box": 2,
    "terminal": "https://term.box.localhost/",
    "project": "https://{project}.box.localhost/",
    "passkeys": "https://box.localhost/auth/passkeys",
    "previews": "https://box.localhost/dev/",
    "push": "<the box's VAPID public key>",
    "image": { "release": "v0.0.0" }
  }
}
