+// kit-986 (APPS-S4): the harness fails a test on any CSP violation, naming the directive and what it blocked.
+// The build's page with one more inline script, which the route's hashes don't name: every call on the page
+// fails from then on, and when no call follows, the browser's close() fails.
+test('a CSP violation fails the test: an inline script missing from the page\'s hashes', { skip, timeout: 60000 }, async () => {
+  const page = () => Buffer.from(cliRead(fs.readFileSync, fs, PAGE, 'utf8').replace('</body>', '<script>window.notHashed = 1;</script></body>'));
+  const srv = await startServer({ page });
+  const own = await openChrome();
+  let closed = false;
+  const said = /CSP violation: script-src-elem blocked inline at http:\/\/127\.0\.0\.1:\d+\/:\d+/;
+  try {
+    const p = await own.newPage();
+    await p.send('Page.navigate', { url: `${srv.origin}/` });
+    // only the violation's failure ends the wait: a call that crosses the navigation's commit fails otherwise
+    const e = await until(async () => { try { await p.ev('document.readyState'); return false; } catch (x) { return said.test(x.message) ? x : false; } }, 'a call on the page that fails', 10000);
+    assert.match(e.message, new RegExp(`^Runtime\\.evaluate: ${said.source}`));
+    assert.match((await p.ev('1').then(() => null, (x) => x))?.message ?? '', said, 'and the next one: a failure swallowed loses nothing');
+    assert.deepEqual(p.violations().map((v) => [v.directive, v.blocked]), [['script-src-elem', 'inline']], 'taken, once');
+    assert.equal(await p.ev('window.notHashed'), undefined, 'the script never ran, and once taken the page answers again');
+    p.close();
+    const q = await own.newPage();
+    await q.send('Page.navigate', { url: `${srv.origin}/` });
+    await srv.waitConn(2);
+    await sleep(300);
+    q.close();
+    const c = await own.close().then(() => null, (x) => x);
+    closed = true;
+    assert.match(c?.message ?? '', new RegExp(`^${said.source}`), "with no call after it, the browser's close() fails");
+  } finally { if (!closed) await own.close().catch(() => {}); await srv.close(); }
+});
