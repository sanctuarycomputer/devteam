    "pattern": "^[a-z]-\\d{8}-\\d{9}-[a-z0-9]+(-[a-z0-9]+)*$",
    "keyed": {
      "ticket": "^[a-z][a-z0-9]*(-[a-z0-9]+)*-[0-9]{2,}-[a-z0-9]+(-[a-z0-9]+)*$",
      "feature": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    }
  },
