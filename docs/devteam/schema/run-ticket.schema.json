{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "devteam/run-ticket.schema.json",
  "title": "Live ticket state",
  "description": "What only the worker knows about its ticket right now. Runtime file at docs/devteam/run/tickets/<id>.json, written only by that ticket's worker (and by the supervisor during recovery).",
  "type": "object",
  "required": ["id", "phase", "heartbeat_at"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "phase": { "enum": ["spawned", "spec", "plan", "contract", "build", "verify", "final-review", "awaiting-word", "merging", "done", "blocked", "parked"] },
    "task": { "type": ["string", "null"], "description": "current plan task, e.g. T3" },
    "session": { "type": "string", "description": "tmux target, e.g. devteam:api-07-session-tokens" },
    "worktree": { "type": "string" },
    "branch": { "type": "string" },
    "head_sha": { "type": ["string", "null"] },
    "started_at": { "type": "string", "format": "date-time" },
    "heartbeat_at": { "type": "string", "format": "date-time" },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "usd": { "type": "number", "minimum": 0 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "source": { "enum": ["gateway", "agent-report", "estimate"] }
      }
    },
    "note": { "type": "string", "maxLength": 280 }
  }
}
