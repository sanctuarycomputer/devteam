{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "devteam/ticket.schema.json",
  "title": "Graph ticket",
  "description": "One ticket of the work graph: one future PR. Tracked at docs/devteam/project/graph/<id>.json. Written by planning (process/planning.md section 5); never holds live status.",
  "type": "object",
  "required": ["id", "title", "feature", "component", "kind", "size", "risk", "serves", "depends_on", "touches", "done_when"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*-[0-9]{2,}-[a-z0-9]+(-[a-z0-9]+)*$", "description": "<component>-<NN>-<slug>; must equal the file name without .json" },
    "title": { "type": "string", "minLength": 3, "maxLength": 100 },
    "feature": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "feature slug; chore and spike tickets outside any feature plan use the reserved value \"chores\"" },
    "component": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
    "kind": { "enum": ["contract", "build", "integration", "chore", "spike"] },
    "size": { "enum": ["S", "M"] },
    "risk": { "enum": ["normal", "high"] },
    "serves": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-S[0-9]+$" }, "uniqueItems": true },
    "depends_on": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provides": { "type": "array", "items": { "type": "string" } },
        "consumes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "touches": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "done_when": { "type": "array", "items": { "type": "string", "minLength": 10 }, "minItems": 1 },
    "one_way_doors": { "type": "array", "items": { "type": "string" } },
    "superseded_by": { "type": ["string", "null"] },
    "notes": { "type": "string" }
  }
}
