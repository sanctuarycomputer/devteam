{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "devteam/event.schema.json",
  "title": "Event",
  "description": "One line of docs/devteam/run/events.jsonl, the append-only history every session reads to catch up. Includes every message sent between sessions. Append with a single write of one line.",
  "type": "object",
  "required": [
    "ts",
    "type",
    "actor"
  ],
  "additionalProperties": false,
  "properties": {
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "type": {
      "enum": [
        "worker.made",
        "ticket.phase",
        "ticket.blocked",
        "ticket.parked",
        "ticket.merged",
        "ticket.released",
        "question.asked",
        "question.answered",
        "question.defaulted",
        "review.verdict",
        "word.stage",
        "word.merge",
        "approve.spec",
        "approve.plan",
        "approve.design-change",
        "ruling",
        "gate.result",
        "slot.granted",
        "slot.released",
        "replan",
        "recovery",
        "defect.escaped",
        "cost",
        "message",
        "improvement"
      ]
    },
    "actor": {
      "type": "string",
      "description": "ticket id, 'supervisor', 'owner', 'planner' (or a planner's window name for messages) or 'ci'"
    },
    "ticket": {
      "type": [
        "string",
        "null"
      ]
    },
    "sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 280
    },
    "ref": {
      "type": [
        "string",
        "null"
      ],
      "description": "file path or URL with the detail"
    },
    "to": {
      "type": [
        "string",
        "null"
      ],
      "description": "message recipient: 'supervisor', a ticket id, or a planner's window name"
    },
    "kind": {
      "enum": [
        "design-change",
        "merge-request",
        "review-request",
        "slot-request",
        "blocked",
        "ruling",
        "answer",
        "info"
      ],
      "description": "message kind (process/messages.md)"
    },
    "id": {
      "type": "string",
      "pattern": "^m-[0-9]{8}-[0-9]{9}-[a-z0-9-]+$",
      "description": "message id"
    },
    "re": {
      "type": [
        "string",
        "null"
      ],
      "description": "id of the message this one replies to"
    },
    "phase": {
      "type": [
        "string",
        "null"
      ],
      "description": "cost samples: the phase the spend since the previous sample belongs to"
    },
    "usd": {
      "type": "number",
      "minimum": 0,
      "description": "cost samples: cumulative spend for this session"
    },
    "input_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "output_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "gate": {
      "type": "string",
      "description": "gate.result: the gate's name"
    },
    "ok": {
      "type": "boolean",
      "description": "gate.result: passed or failed"
    },
    "ms": {
      "type": "integer",
      "minimum": 0,
      "description": "gate.result: duration"
    }
  }
}
